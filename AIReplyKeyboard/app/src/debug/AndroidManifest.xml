<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only manifest: adb test hook + chat simulator exist solely in debug builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".ime.TestHookReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aireply.keyboard.TEST" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".debug.ChatSimActivity"
            android:exported="true"
            android:label="ChatSim"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
